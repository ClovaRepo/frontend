# CLOVA Frontend — environment template
# cp .env.example .env.local

# URL backend agen (dari Orang 2)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# RPC untuk frontend — WAJIB pakai Alchemy app BERBEDA dari backend (BASE_RPC_URL).
# Buat app baru di dashboard.alchemy.com → salin URL ke sini.
# Jangan share key yang sama antara frontend dan backend — akan melebihi 500 CU/s limit Alchemy.
NEXT_PUBLIC_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/GANTI_DENGAN_KEY_FE_SENDIRI
